# Copie para .env e preencha (o .env fica fora do Git). Nunca coloque credenciais reais neste arquivo.
#   cp .env.example .env

# Oracle da FIAP: o MESMO schema onde o .NET criou as tabelas T_RFG_*.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521/ORCL
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# A MESMA chave do .NET (variável Jwt__Chave da VM no Azure), com pelo menos 32 caracteres.
# Sem a mesma chave, o token emitido pelo .NET não vale no Java (e vice-versa).
JWT_CHAVE=

# Provedor de LLM do ia-service: openai (padrão) ou ollama.
SPRING_AI_PROVEDOR=openai
# Chave da API da OpenAI (https://platform.openai.com/api-keys). Nunca no repositório.
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini
# Só se SPRING_AI_PROVEDOR=ollama (rodar offline, sem chave)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2
